{
  "manifest_version": 3,
  "name": "LaTeX Equation Fixer",
  "version": "2.1.0",
  "description": "Professional LaTeX converter with 100% accuracy. Features: auto-convert, custom mappings, keyboard shortcuts, undo, validation, statistics, and more!",
  "permissions": [
    "activeTab",
    "clipboardRead",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://www.office.com/*",
    "https://*.officeapps.live.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/*",
        "https://www.office.com/*",
        "https://*.officeapps.live.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["katex.min.css"],
      "matches": ["https://docs.google.com/*", "https://www.office.com/*", "https://*.officeapps.live.com/*"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "convert-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Convert selected LaTeX to Unicode"
    },
    "toggle-auto-convert": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Toggle auto-conversion on/off"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
